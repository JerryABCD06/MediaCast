#include <windows.h>

#define IDI_MCAST 101

IDI_MCAST ICON "mcast.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     0,1,0,0
 PRODUCTVERSION  0,1,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Media Cast Protocol"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "MCast.Protocol"
            VALUE "OriginalFilename", "MCast.Protocol.exe"
            VALUE "ProductName",      "Media Cast"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
