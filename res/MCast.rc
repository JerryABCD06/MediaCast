// MCast.rc -- 程序图标 和 版本信息
//
// 这个文件里放两样东西：
//
//   IDI_MCAST       可执行文件自己的图标。资源管理器、任务栏、还有那个媒体面板，
//                   都从这里取图标。
//
//   VS_VERSION_INFO 系统**从哪里知道这个程序叫什么名字**。
//
//                   未打包的 Win32 程序在 Windows 里没有"身份"（没有 package
//                   identity），所以媒体面板找不到名字时，只能退回去显示可执行
//                   文件的完整路径，前面再加一句"未知应用"。它会读的就是这里的
//                   FileDescription，所以 "Media Cast" 写在这一项上。
//
// 注意：这个文件要保持纯 ASCII。rc.exe 是按系统代码页（中文 Windows 上是 GBK）
// 读 .rc 的，写中文进来会变成乱码。
// （项目里别的源文件是中文明注，因为 MSVC 那边加了 /utf-8；rc.exe 没有这个开关。）

#include <windows.h>

#define IDI_MCAST 101

IDI_MCAST ICON "mcast.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     0,1,0,0
 PRODUCTVERSION  0,1,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Media Cast"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "MCast"
            VALUE "OriginalFilename", "MCast.exe"
            VALUE "ProductName",      "Media Cast"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
